# =============================================================================
# TrustedAI Movie Discovery Assistant — .gitignore
# =============================================================================

# ── Environment & Secrets ────────────────────────────────────────────────────
.env
*.env.local
*.env.*.local

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── Data & Large Files ───────────────────────────────────────────────────────
# Uncomment below if you want to exclude the dataset from git (it's 18MB+)
# data/

# ── Jupyter Notebooks (temp artifacts) ───────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDE & Editor ─────────────────────────────────────────────────────────────
.idea/
.vscode/
.cursor/
.agents/
*.code-workspace
*.swp
*.swo
*~

# ── macOS & Windows System Files ─────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
Icon?
Thumbs.db

# ── Pytest, Linters & Coverage ──────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
*.coveragerc

# ── Logs & Temp ──────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
scratch/

# ── scikit-learn / numpy cache ───────────────────────────────────────────────
*.pkl
*.pickle
*.npy
*.npz

# ── Internal Planning & Working Documents (NOT for reviewers) ────────────────
# These are internal scratch/planning files used during development.
# They expose step-by-step reasoning and changelog internals — not polished deliverables.
PLAN.md

# ── Exam Template Files (already referenced in README) ───────────────────────
# REPORT_TEMPLATE.md is the original exam template — content absorbed into REPORT.md.
# README_ORIGINAL.md is the original exam brief — already linked from README.md.
REPORT_TEMPLATE.md
README_ORIGINAL.md

# ── Output Deliverables (DO NOT IGNORE) ──────────────────────────────────────
# output/cached_llm_responses.json  → Required for offline demo mode
# output/sample_conversations.md    → Reproducible conversation evidence (exam requirement)
# output/qa_200_test_results.json   → Full 200-test audit trail
# output/sample_prompts_audit_results.json → Evaluation evidence
# All output/ files are intentionally tracked.

